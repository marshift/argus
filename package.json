{
	"name": "@marshift/argus",
	"description": "marsh's tiny argument parsing library",
	"author": "marshift",
	"version": "1.2.2",
	"license": "BSD-3-Clause",
	"type": "module",
	"files": [
		"./src/",
		"./dist/"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepublish": "tsup ./src/index.ts --clean --dts --format esm,cjs"
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	}
}
